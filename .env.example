MONGO_URI=
JWT_SECRET=
PORT=5000
# Server-side only. Create a Twilio Verify service with six-digit codes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Email reset: use your mail provider's SMTP credentials, never NEXT_PUBLIC_.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Trusted frontend origin; HTTPS in production, localhost HTTP for development.
FRONTEND_URL=http://localhost:3000

# Render Free: select EMAIL_PROVIDER=resend and use HTTPS instead of SMTP.
RESEND_API_KEY=
# Must use a domain verified with Resend for real user recipients.
EMAIL_FROM=
